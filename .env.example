# GEMINI_API_KEY: Required for Gemini AI multimodal extraction and investigation synthesis.
# Configured via Secrets in AI Studio or local .env file (server-side only).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# PORT: Server listening port (defaults to 3000).
PORT=3000
